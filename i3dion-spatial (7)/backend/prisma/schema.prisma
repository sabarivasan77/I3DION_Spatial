datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  OPERATOR
  ADMIN
  ENTERPRISE_MANAGER
}

model User {
  id           String             @id @default(uuid())
  email        String             @unique
  passwordHash String
  role         Role               @default(USER)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  profile      Profile?
  downloads    Download[]
  watchlist    Watchlist[]
  sessions     AuthSession[]
  analytics    AnalyticsEvent[]

  @@map("users")
}

model Profile {
  id          String   @id @default(uuid())
  name        String
  companyName String?
  jobTitle    String?
  avatarUrl   String?
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedAt   DateTime @updatedAt

  @@map("profiles")
}

model Category {
  id       String    @id @default(uuid())
  name     String    @unique
  slug     String    @unique
  products Product[]

  @@map("categories")
}

model Product {
  id                 String           @id @default(uuid())
  name               String
  description        String
  categoryId         String
  category           Category         @relation(fields: [categoryId], references: [id])
  thumbnail          String           @default("")
  modelUrl           String           @default("")
  fileSize           String           @default("0.0 MB")
  version            String           @default("1.0.0")
  isAvailableOffline Boolean          @default(true)
  documentName       String?
  documentUrl        String?
  specs              String?          // Split values via pipe (|)
  benefits           String?          // Split values via pipe (|)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  downloads          Download[]
  watchlist          Watchlist[]
  qrCode             QRCode?
  analytics          AnalyticsEvent[]

  @@map("products")
}

model Download {
  id           String   @id @default(uuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  downloadDate DateTime @default(now())
  device       String   @default("Android Device")
  appVersion   String   @default("1.0.0")

  @@map("downloads")
}

model Watchlist {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@map("watchlists")
}

model QRCode {
  id          String   @id @default(uuid())
  type        String   @default("product")
  payload     String   @unique // Match client QR design: JSON strings containing type & id
  qrImageUrl  String
  productId   String   @unique
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  scansCount  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("qr_codes")
}

model AnalyticsEvent {
  id              String   @id @default(uuid())
  eventType       String   // e.g. "MODEL_LOADED", "AR_OPENED", "PLACEMENT_SUCCESS", "PLACEMENT_FAILURE", "QR_SCANNED"
  productId       String?
  product         Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  userId          String?
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  deviceModel     String   @default("Unknown")
  sessionDuration Int      @default(0) // Seconds
  metadata        String?  // JSON stringified properties
  timestamp       DateTime @default(now())

  @@map("analytics_events")
}

model AuthSession {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String
  deviceDetails String?
  isRevoked    Boolean  @default(false)
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@map("auth_sessions")
}
