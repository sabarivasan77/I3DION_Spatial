{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "skipLibCheck": true,
    "allowJs": true,
    "noEmit": true
  },
  "include": [
    "api/**/*",
    "backend/**/*"
  ],
  "exclude": [
    "frontend",
    "node_modules",
    "dist"
  ]
}
